<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="content">
  <div class="wrap page-gap narrow-page">
    <header class="page-head">
      <p class="kicker">Directory</p>
      <h1><%= organizationId ? 'Edit host' : 'New host' %></h1>
    </header>
    <%- include('../partials/office-nav') %>
    <form class="sheet" method="post" action="<%= organizationId ? '/admin/organizations/' + organizationId : '/admin/organizations' %>">
      <%- include('../partials/errors') %>
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label class="field">
        <span>Name</span>
        <input type="text" name="name" required value="<%= form.name || '' %>">
      </label>
      <div class="field-row">
        <label class="field">
          <span>Field</span>
          <input type="text" name="industry" required value="<%= form.industry || '' %>" placeholder="Publishing">
        </label>
        <label class="field">
          <span>Place</span>
          <input type="text" name="location" required value="<%= form.location || '' %>">
        </label>
      </div>
      <label class="field">
        <span>Description</span>
        <textarea name="description" rows="6" required><%= form.description || '' %></textarea>
      </label>
      <div class="field-row">
        <label class="field">
          <span>Website</span>
          <input type="url" name="website" value="<%= form.website || '' %>" placeholder="https://">
        </label>
        <label class="field">
          <span>Contact email</span>
          <input type="email" name="contact_email" value="<%= form.contact_email || '' %>">
        </label>
      </div>
      <div class="row-actions">
        <button class="btn btn-primary" type="submit">Save host</button>
        <a class="text-link" href="/admin/organizations">Cancel</a>
      </div>
    </form>
  </div>
</main>
<%- include('../partials/footer') %>
