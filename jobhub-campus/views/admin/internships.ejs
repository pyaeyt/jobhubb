<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="content">
  <div class="wrap">
    <header class="page-head page-head-row">
      <div>
        <p class="kicker">The board</p>
        <h1>Internships</h1>
      </div>
      <a class="btn btn-primary" href="/admin/internships/new">Post an internship</a>
    </header>
    <%- include('../partials/office-nav') %>
    <% if (!posts.length) { %>
      <p class="empty">The board is empty.</p>
    <% } else { %>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th>Posting</th>
              <th>Field</th>
              <th>Deadline</th>
              <th>State</th>
              <th>Files</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% posts.forEach((post) => { %>
              <tr>
                <td>
                  <a href="/internships/<%= post.id %>"><%= post.title %></a>
                  <span class="quiet"><%= post.organization_name %></span>
                </td>
                <td><%= post.field %></td>
                <td><%= formatDate(post.deadline) %></td>
                <td><%= post.status === 'open' ? 'Open' : 'Closed' %></td>
                <td><%= post.application_count %></td>
                <td>
                  <div class="row-actions">
                    <a class="text-link" href="/admin/internships/<%= post.id %>/edit">Edit</a>
                    <form method="post" action="/admin/internships/<%= post.id %>/delete" data-confirm="Remove this internship and its applications?">
                      <input type="hidden" name="_csrf" value="<%= csrf %>">
                      <button class="btn btn-small btn-danger" type="submit">Remove</button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>
<%- include('../partials/footer') %>
