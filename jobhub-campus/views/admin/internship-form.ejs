<% const paidValue = form.paid === undefined || form.paid === null || form.paid === '' ? '1' : String(form.paid); %>
<%- include('../partials/head') %>
<%- include('../partials/header') %>
<main id="content">
  <div class="wrap page-gap">
    <header class="page-head">
      <p class="kicker">The board</p>
      <h1><%= internshipId ? 'Edit internship' : 'New internship' %></h1>
    </header>
    <%- include('../partials/office-nav') %>
    <% if (!organizations.length) { %>
      <p class="empty">Add a host before posting an internship. <a href="/admin/organizations/new">Add a host</a>.</p>
    <% } else { %>
      <form class="sheet sheet-wide" method="post" action="<%= internshipId ? '/admin/internships/' + internshipId : '/admin/internships' %>">
        <%- include('../partials/errors') %>
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <div class="field-row">
          <label class="field">
            <span>Title</span>
            <input type="text" name="title" required value="<%= form.title || '' %>">
          </label>
          <label class="field">
            <span>Host</span>
            <select name="organization_id" required>
              <option value="">Choose</option>
              <% organizations.forEach((org) => { %>
                <option value="<%= org.id %>" <%= String(form.organization_id || '') === String(org.id) ? 'selected' : '' %>><%= org.name %></option>
              <% }) %>
            </select>
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>Field of study</span>
            <select name="field" required>
              <option value="">Choose</option>
              <% fields.forEach((field) => { %>
                <option value="<%= field %>" <%= form.field === field ? 'selected' : '' %>><%= field %></option>
              <% }) %>
            </select>
          </label>
          <label class="field">
            <span>Manner</span>
            <select name="mode" required>
              <option value="">Choose</option>
              <% modes.forEach((mode) => { %>
                <option value="<%= mode %>" <%= form.mode === mode ? 'selected' : '' %>><%= mode %></option>
              <% }) %>
            </select>
          </label>
        </div>
        <label class="field">
          <span>Description</span>
          <textarea name="description" rows="6" required><%= form.description || '' %></textarea>
        </label>
        <label class="field">
          <span>What the student should bring</span>
          <textarea name="requirements" rows="4" required><%= form.requirements || '' %></textarea>
        </label>
        <div class="field-row">
          <label class="field">
            <span>Place</span>
            <input type="text" name="location" required value="<%= form.location || '' %>">
          </label>
          <label class="field">
            <span>Deadline</span>
            <input type="date" name="deadline" required value="<%= form.deadline || '' %>">
          </label>
        </div>
        <div class="field-row">
          <label class="field">
            <span>Weeks</span>
            <input type="number" name="duration_weeks" min="1" max="52" required value="<%= form.duration_weeks || '' %>">
          </label>
          <label class="field">
            <span>Places</span>
            <input type="number" name="openings" min="1" max="50" required value="<%= form.openings || '' %>">
          </label>
        </div>
        <fieldset class="choices">
          <legend>Stipend</legend>
          <label><input type="radio" name="paid" value="1" <%= paidValue === '1' ? 'checked' : '' %>> Paid</label>
          <label><input type="radio" name="paid" value="0" <%= paidValue === '0' ? 'checked' : '' %>> Unpaid</label>
        </fieldset>
        <label class="field" data-stipend>
          <span>Monthly stipend in USD</span>
          <input id="stipend" type="number" name="stipend" min="1" max="20000" value="<%= form.stipend || '' %>">
        </label>
        <label class="field">
          <span>State</span>
          <select name="status">
            <option value="open" <%= form.status !== 'closed' ? 'selected' : '' %>>Open</option>
            <option value="closed" <%= form.status === 'closed' ? 'selected' : '' %>>Closed</option>
          </select>
        </label>
        <div class="row-actions">
          <button class="btn btn-primary" type="submit">Save internship</button>
          <a class="text-link" href="/admin/internships">Cancel</a>
        </div>
      </form>
    <% } %>
  </div>
</main>
<%- include('../partials/footer') %>
